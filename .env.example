# Discord bot that reads the #announcements channel for the Live Dashboard.
# Needs View Channel + Read Message History there, and the Message Content intent.
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=

# Optional locally. Set as Sensitive in the production Vercel environment.
# Keep the attendee schedule and event Discord invite out of version control.
ITB_ATTENDEE_CONFIG_JSON=
# Optional private schedule-only snapshot: { "rows": [...], "submissionDeadline": "..." }.
# Overrides those fields while retaining the original private links and display metadata.
ITB_ATTENDEE_RUN_OF_SHOW_JSON=

# Optional: My Badge Wallet pass signing. Use the three multiline PEM values
# as server-only secrets. Leave blank to show only the existing QR.
ITB_WALLET_SIGNER_CERT_PEM=
ITB_WALLET_SIGNER_KEY_PEM=
ITB_WALLET_WWDR_PEM=

# Optional: attach this hostname to the same app before enabling.
# Leave unset to keep the dashboard at /dashboard.
# NEXT_PUBLIC_LIVE_URL=https://live.immersethebay.org
